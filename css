body{
    margin:0;
    height:100vh;
    font-family: Arial, Helvetica, sans-serif;
    background: linear-gradient(120deg,#1d2671,#c33764);
    display:flex;
    justify-content:center;
    align-items:center;
}

.container{
    width:850px;
    height:500px;
    background:#fff;
    display:flex;
    border-radius:20px;
    overflow:hidden;
    box-shadow:0 20px 40px rgba(0,0,0,0.4);
}

.left{
    width:50%;
    background:url("https://images.unsplash.com/flagged/photo-1571260899304-425eee4c7efc?auto=format&fit=crop&w=1000&q=80");
    background-size:cover;
    color:#fff;
    padding:50px;
}

.left h1{
    font-size:40px;
}

.left p{
    font-size:20px;
}

.right{
    width:50%;
    padding:60px;
    text-align:center;
}

.right h2{
    margin-bottom:30px;
}

input{
    width:100%;
    padding:12px;
    margin:12px 0;
    border-radius:30px;
    border:1px solid #ccc;
    outline:none;
}

button{
    width:100%;
    padding:12px;
    margin-top:15px;
    background:linear-gradient(45deg,#1d2671,#c33764);
    color:white;
    border:none;
    border-radius:30px;
    font-size:18px;
    cursor:pointer;
}

button:hover{
    opacity:0.9;
}

.links{
    margin-top:20px;
}

.links a{
    text-decoration:none;
    color:#1d2671;
    font-weight:bold;
}
